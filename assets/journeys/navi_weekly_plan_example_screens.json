  "screenPrompts": {
    "navi-weekly-plan-start": "Screen ID: navi-weekly-plan-start\\nAvailable Events: navigate_to_weekly_plan_intro\\n\\nPurpose: Show AI disclaimer and privacy commitments before voice starts.\\n\\nBehavior: This is CTA-only (no voice). On Continue, navigate to navi-weekly-plan-intro.",
    "navi-weekly-plan-intro": "Screen ID: navi-weekly-plan-intro\\nAvailable Events: navigate_to_weekly_plan_conversation\\n\\nPurpose: Show welcome/program overview UI before starting voice.\\n\\nBehavior: This is CTA-only (no voice). On Talk to Navi, enable voice and navigate to navi-weekly-plan-conversation.",
    "navi-weekly-plan-conversation": "Screen ID: navi-weekly-plan-conversation\\nAvailable Events: navigate_to_tracking_frequency\\n\\nPurpose: Run non-linear 3B conversation. Capture and confirm behavior, barrier, and benefit in member words.\\n\\nAfter confirmation, call record_input three times with store keys behavior_specific, barrier, benefit_specific, then trigger_event navigate_to_tracking_frequency.",
    "navi-tracking-frequency": "Screen ID: navi-tracking-frequency\\nAvailable Events: select_tracking_every_day, select_tracking_few_times, select_tracking_when_i_remember, navigate_to_plan_handoff\\n\\nPurpose: Ask how often to track and store the chosen frequency.\\n\\nCall one selection event based on user response, then trigger_event navigate_to_plan_handoff.",
    "navi-plan-handoff": "Screen ID: navi-plan-handoff\\nAvailable Events: navigate_to_weekly_plan_completion\\n\\nPurpose: Confirm handoff to UI and continue to completion screen.",
    "navi-weekly-plan-completion": "Screen ID: navi-weekly-plan-completion\\nAvailable Events: complete_weekly_plan_setup\\n\\nPurpose: End weekly plan setup flow. Call trigger_event complete_weekly_plan_setup then end_call."
  }
